{
  "source": "scripts/train_reward_components.py",
  "gamma": 0.96,
  "dynamics_sigma": 0.0005,
  "deterministic_sigma_scale": 0.001,
  "deterministic_sigma": 5e-07,
  "Lr_definition": "|R(s1')-R(s2')| / ||s1'-s2'||",
  "Lr_grouping": "next_state_tile",
  "Lr_action_dependence": false,
  "Lf_definition": "||s1'-s2'|| / ||s1-s2||",
  "Lf_grouping": "source_category_action",
  "Lq_definition": "Lr*Lf/(1-gamma*Lf)",
  "method_notes": {
    "Lr": "Per-NEXT-STATE-tile 10% trimmed pairwise ratios on free transitions |R(s1')-R(s2')|/||s1'-s2'||, pooled over action (reward is R(s')); Lr_sum = Lr1 + Lr2. Lr replicated across all action rows of the tile; Lr_action_dependence = false.",
    "Lf": "Per-source-category/action 10% trimmed pairwise dynamics ratios ||s1'-s2'||/||s1-s2||; Lf_sum = max(Lf1, Lf2) from R1/R2 behavior.",
    "LQ_bellman_bound": "LQ_bellman_bound = Lr(Ti) * Lf(Ci,a) / (1 - gamma * Lf(Ci,a)); requires gamma * Lf_sum < 1.",
    "Lq_empirical_sum": "Diagnostic per-source tile/action empirical |Q-Q|/||s1-s2||; NOT used for production theoretical bounds.",
    "pruning_radius": "Student-t L2 radius of next free s' around s+delta_mean; RA-DQN uses the live env",
    "delta_estimation": "Exclude boundary cancel/clip from delta and Lipschitz sample sets so deterministic regions can report std\u22480 for the free step"
  },
  "lipschitz_method_version": 3,
